{
  "schemaVersion": 1,
  "id": "p1-locale-prefix-migration",
  "date": "2026-11-23",
  "task": "p1b",
  "title": "全站双语前缀迁移（/zh/** 与 /en/**）、语言切换与旧链接 301/静态重定向",
  "rationale": "将中文正文章节与交叉检索工具统一迁移至 /zh/**（保留 / 作为中文默认入口与 canonical 主页），启用 /en/** 英文版路由壳与导览状态页，内置 Fumadocs 语言切换器，并为全部旧版无前缀中文路径及历史合并章节提供 301 与保留锚点的静态跳转页。",
  "routes": [
    "/",
    "/coverage",
    "/changes"
  ],
  "routeChanges": [
    {
      "op": "relocate-prefix",
      "fromPrefix": "",
      "toPrefix": "/zh",
      "rationale": "Migrate canonical Chinese edition pages from unprefixed paths to /zh/** to enable parallel /en/** bilingual publication while keeping / as x-default Chinese home."
    }
  ],
