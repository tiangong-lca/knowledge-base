      "caveats": []
    },
    {
      "id": "cl-waste-opposite",
      "text": "openLCA 的 opposite direction approach 使用 product 类型：废物产生过程记录负输入，处理过程记录负输出。",
      "kind": "source-statement",
      "scope": "openLCA 手册所述 opposite direction approach",
