    {
      "id": "cl-waste-material",
      "text": "openLCA 的 material flow logic 将废物记为产生过程的 waste 输出，并作为处理过程的 waste 输入及定量参考。",
      "kind": "source-statement",
      "scope": "openLCA 手册所述 material flow logic",
      "evidenceIds": [
        "ev-waste-material"
      ],
      "premiseIds": [],
