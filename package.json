{
  "name": "@tiangong-lca/knowledge-base",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "next dev",
    "validate": "node scripts/validate.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build": "pnpm validate && next build && node scripts/export.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.17.10",
    "fumadocs-ui": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "tailwindcss": "4.3.4",
    "postcss": "8.5.32",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
