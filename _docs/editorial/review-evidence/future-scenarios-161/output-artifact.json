              "body": [
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "前瞻性 LCA（推荐总称；Arvidsson 等 2024；Steubing 与 de Koning 2021）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "面向未来特定年份或时段，多数按单一时点聚合求解"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "可评估新兴技术，也可在未来背景下评估已成熟技术"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "需用综合评估模型（IAM）耦合未来背景数据库（如超结构＋情景差异文件），避免前景—背景时间错位"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "超结构架构仅解决软件工程瓶颈、不担保情景质量；存在幽灵过程、不确定度与许可局限"
                  }
                ],
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "事前 LCA（Arvidsson 等 2024；Tsoy 等 2020）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "面向技术商业化与大规模投产之前的未来时点"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "必含技术成熟度由实验室／中试向工业规模的放大推演"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "依三步放大框架与流程模拟、手工计算、分子结构模型或代理数据估算工业清单，再耦合未来背景"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "综述 18 项案例中 0 篇报告技术就绪度（TRL）、0 篇完成投产后实测回验，专家参与与流程图披露不足"
                  }
                ],
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "预期式 LCA（Arvidsson 等 2024）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "面向新兴技术未来发展路径"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "与事前 LCA 同样关注早期技术放大"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "在前景与背景建模之外，着重引入利益相关方参与系统边界、功能单位、影响类别与权重选择"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "结果高度依赖参与方价值偏好与治理框架，不可直接替代技术实测"
                  }
                ],
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "实验室尺度 LCA（Arvidsson 等 2024；Tsoy 等 2020）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "当下或近期实验室研究阶段"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "保持低成熟度现状，不做工业规模放大"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "直接使用实验室实测或近似代理数据，通常配以现行背景数据库"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "仅宜用于早期研发热点诊断，不能直接拿去与成熟商业工业技术比拼优劣"
                  }
                ],
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "动态 LCA（Lueddeckens 等 2020；Arvidsson 等 2024）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "按时间点解析排放发生时刻与影响响应（区分评估、清单与特征化三类时间范围）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "不限于新兴技术，重点追踪全生命周期排放时序"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "仅动态清单属半动态；同时耦合动态清单与动态特征化因子才构成全动态 LCA"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "绝大多数类别缺乏动态特征化因子，供应链时序数据与软件受限；时间范围、贴现率与动态归一化暗含价值选择"
                  }
                ]
              ]
            }
          ]
        }
