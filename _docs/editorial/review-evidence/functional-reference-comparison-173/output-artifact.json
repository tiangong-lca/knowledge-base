              "body": [
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "ILCD 2010（第 6.4、6.10 节）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "研究层功能单位（做什么、做多少、质量、时长）与参考流"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "采用声明单位（如 1 kg 钢卷），明言其非功能单位"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "区分必备属性与定位属性；表 4 墙漆十年期折算为 6.5 l 对 3.8 l"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "比较研究须同步核验情景、寿命、维护、数据与建模一致性"
                  }
                ],
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "欧盟 PEF（2021/2279 附录一第 1、3.2.1 节）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "研究层四要素功能单位（如装饰漆 1 m²、50 年、遮盖力 ≥ 98%）与参考流"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "中间产品可采用声明单位（此时参考流可与功能单位一致）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "寿命产品数原则上向上取整；强制披露并论证未涵盖属性"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "仅在严格遵循适用 PEFCR 时允许比较与公开比较断言"
                  }
                ],
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "GHG Protocol 产品标准 2011（第 6 章、第 7.3.7 节、附录 A）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "研究层上位“分析单位”与参考流；最终产品以功能单位为分析单位"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "不使用声明单位，直接以参考流为分析单位并可摇篮到大门披露"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "允许先定功能单位或先定参考流，须防止半个产品失真"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "按现状仅支持同产品绩效追踪，不支持 ISO 14044 比较断言"
                  }
                ],
                [
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "ecoinvent 第三版导则 2013（第 3、4.1.2、14.1–14.3 节）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "单元过程活动层决定性参考产品（处理服务记为负参考产品）"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "中间产品默认按单元过程参考产品连接本地市场"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "不规定研究层寿命取整或定位属性，交由下游研究处理"
                  },
                  {
                    "tag": "TD",
                    "attributes": {},
                    "text": "仅提供活动层数据连接基础，不直接构成服务等价证明"
                  }
                ]
              ]
            }
          ]
        }
